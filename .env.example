# Copy to .env and adjust. Never commit .env.
# These values are for LOCAL DEVELOPMENT ONLY.

# --- API --------------------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 keeps the dev server off the local network. Containers use 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# Signs access tokens. REQUIRED, at least 32 characters, and different in every
# environment. Generate one with:  openssl rand -base64 48
# Anyone who knows this value can forge a login for any user.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# The exact origin the web app is served from (scheme + host + port, no path).
# State-changing requests from any other origin are refused.
APP_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# PostgreSQL connection used by the API, the worker and Prisma's CLI.
# Port 5433 is the Docker Compose Postgres (added in Phase 6); a Postgres
# installed directly on the host normally listens on 5432.
DATABASE_URL=postgresql://pulsewatch:pulsewatch_dev_password@localhost:5433/pulsewatch

# Integration tests (optional).
# By default the tests start a throwaway Postgres with Testcontainers, which
# needs Docker. To use an existing server instead, point this at a role that
# may CREATE DATABASE. Each test run creates its own database and drops it.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
