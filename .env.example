# Copy to .env and adjust. Never commit .env.
# These values are for LOCAL DEVELOPMENT ONLY.

# --- API --------------------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 keeps the dev server off the local network. Containers use 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# Signs access tokens. REQUIRED, at least 32 characters, and different in every
# environment. Generate one with:  openssl rand -base64 48
# Anyone who knows this value can forge a login for any user.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# The exact origin the web app is served from (scheme + host + port, no path).
# State-changing requests from any other origin are refused.
APP_ORIGIN=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------
# Requests per minute per client IP, counted in Redis across all API instances.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set to true ONLY behind a reverse proxy you control; otherwise clients can
# forge X-Forwarded-For to dodge the limits above.
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
# PostgreSQL connection used by the API, the worker and Prisma's CLI.
# Port 5433 is the Docker Compose Postgres; a Postgres
# installed directly on the host normally listens on 5432.
DATABASE_URL=postgresql://pulsewatch:pulsewatch_dev_password@localhost:5433/pulsewatch

# --- Redis and worker ------------------------------------------------------
# Job queue, live events and rate-limit counters. Port 6379 is the Compose Redis.
REDIS_URL=redis://localhost:6379
# How many checks one worker process runs at once (open sockets, not CPU).
WORKER_CONCURRENCY=20
# How often the scheduler looks for due monitors, and how many it claims.
SCHEDULER_TICK_MS=1000
SCHEDULER_BATCH_SIZE=500
# Days of raw check results to keep (minimum 30, the longest analytics range).
RETENTION_DAYS=30
# Worker metrics endpoint (Prometheus). Internal only.
METRICS_HOST=127.0.0.1
METRICS_PORT=9100

# --- Alert email (optional) -------------------------------------------------
# Without SMTP_URL, alert emails are written to the worker log instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=PulseWatch <alerts@localhost>

# Integration tests (optional).
# By default the tests start a throwaway Postgres with Testcontainers, which
# needs Docker. To use an existing server instead, point this at a role that
# may CREATE DATABASE. Each test run creates its own database and drops it.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
# Likewise for Redis; otherwise a throwaway container is started.
# TEST_REDIS_URL=redis://localhost:6379
