{
  "name": "pulsewatch",
  "version": "0.1.0",
  "private": true,
  "description": "API monitoring platform: uptime checks, incident detection and latency analytics.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "pnpm build:packages && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r run test",
    "dev:api": "pnpm build:packages && pnpm --filter @pulsewatch/api run dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @pulsewatch/worker run dev",
    "db:generate": "pnpm --filter @pulsewatch/database run generate",
    "db:migrate:dev": "pnpm --filter @pulsewatch/database run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @pulsewatch/database run migrate:deploy",
    "db:check-drift": "pnpm --filter @pulsewatch/database run check-drift",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
